# Server config
PORT=8000
SECRET_KEY=super-secret-key-replace-in-production-hungph-blog-2026

# Database: SQLite locally, hoặc Supabase PostgreSQL (khuyên dùng):
# Dùng chuỗi URI từ Supabase (Session Pooler hoặc Direct):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./blog.db

# Admin default account
ADMIN_EMAIL=admin@hungph.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# CORS: Domain Vercel khi deploy frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Cloudinary — Image CDN (Free 25GB, dùng chung cho cả local & production)
# Đăng ký tại https://cloudinary.com rồi lấy từ Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

